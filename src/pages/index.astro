---
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="mx-auto flex max-w-5xl flex-col items-center px-6 py-28 text-center">
    <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">Sangria</h1>
    <p class="mt-5 max-w-xl text-lg text-neutral-600 dark:text-neutral-300">
      Team chat that feels like home.
    </p>
    <a
      href="#download"
      class="mt-9 inline-block rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-700"
    >
      Get started
    </a>
  </main>
</Base>
