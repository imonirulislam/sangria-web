---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Sangria">
  <section
    class="relative isolate flex min-h-[72vh] flex-col items-center justify-center overflow-hidden px-6 text-center"
  >
    <div
      class="glow pointer-events-none absolute -top-24 left-1/2 -z-10 h-80 w-[600px] -translate-x-1/2 text-brand-500/20"
    >
    </div>
    <img
      src="/icon.svg"
      alt=""
      class="size-16 rounded-2xl shadow-lg ring-1 ring-black/5 dark:ring-white/10"
    />
    <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-300">
      404
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">This page wandered off</h1>
    <p class="mt-3 max-w-md text-neutral-600 dark:text-neutral-400">
      The link might be broken, or the page may have moved. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Back home
      </a>
      <a
        href="/features"
        class="rounded-lg border border-neutral-300 px-6 py-3 font-semibold text-neutral-800 transition-colors hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-white/5"
      >
        See features
      </a>
    </div>
  </section>
</Base>
