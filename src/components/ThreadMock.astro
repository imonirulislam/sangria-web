---
// The app's thread pane: 54px header, the parent message, an "N replies" rule,
// replies and the reply composer. Wired for chat-anim.ts (messages arrive,
// reactions tick). data-at = the message's arrival slot; data-target = final count.
import Icon from "./Icon.astro";
import Composer from "./Composer.astro";
import MockFrame from "./MockFrame.astro";

type Reaction = { e: string; target: number; at: number; own?: boolean };

const parent = {
  initials: "MW",
  color: "bg-[#5d6390]",
  name: "Marcus Webb",
  time: "9:36 AM",
  text: "Shipped the new onboarding flow to staging — would love eyes before we roll it out 👀",
  reactions: [
    { e: "🚀", target: 7, at: 0, own: true },
    { e: "🔥", target: 2, at: 0 },
  ] as Reaction[],
};

const replies = [
  {
    initials: "AC",
    color: "bg-[#8a6a55]",
    name: "Ava Chen",
    time: "9:41 AM",
    text: "Looks great on mobile too 🎉",
    reactions: [{ e: "🎉", target: 3, at: 1 }] as Reaction[],
  },
  {
    initials: "PN",
    color: "bg-[#4f7a68]",
    name: "Priya Nair",
    time: "9:44 AM",
    text: "One nit on the empty state — dropping a comment.",
    reactions: [] as Reaction[],
  },
];

const pill = (own?: boolean) =>
  own
    ? "bg-mock-accent/12 text-mock-accent-ink font-black shadow-[inset_0_0_0_1px_var(--mock-accent)]"
    : "bg-mock-subtle font-bold text-mock-muted shadow-[inset_0_0_0_1px_var(--mock-border)]";
---

<MockFrame framed>
  <div class="flex h-[54px] items-center gap-2 pr-3 pl-5 shadow-[inset_0_-1px_0_var(--mock-border)]">
    <span class="text-lg font-black">Thread</span>
    <span class="flex-1 truncate text-[13px] text-mock-muted">#general</span>
    <span class="flex size-[30px] items-center justify-center text-mock-muted">
      <Icon name="x" class="size-4" />
    </span>
  </div>

  <div data-chat class="flex flex-col gap-1 pt-3.5 pb-2 text-[15px]">
    {
      [parent, ...replies].map((m, i) => (
        <>
          <div data-msg class="msg-pre flex gap-2.5 px-5 py-1.5">
            <span
              class:list={[
                "flex size-[34px] shrink-0 items-center justify-center rounded-lg text-xs font-bold text-white",
                m.color,
              ]}
            >
              {m.initials}
            </span>
            <div class="flex min-w-0 flex-col gap-0.5">
              <p class="flex items-baseline gap-2">
                <span class="font-black">{m.name}</span>
                <span class="text-xs text-mock-muted">{m.time}</span>
              </p>
              <p class="leading-normal">{m.text}</p>
              {m.reactions.length > 0 && (
                <div class="mt-1 flex gap-1.5">
                  {m.reactions.map((r) => (
                    <span
                      data-react
                      data-target={r.target}
                      data-at={r.at}
                      class:list={[
                        "react-pre flex h-6 items-center gap-[5px] rounded-full px-2 text-xs",
                        pill(r.own),
                      ]}
                    >
                      {r.e} <span data-count>{r.target}</span>
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
          {i === 0 && (
            <div class="flex items-center gap-2.5 px-5 py-2 text-xs font-bold text-mock-muted">
              {replies.length} replies
              <span class="h-px flex-1 bg-mock-border" />
            </div>
          )}
        </>
      ))
    }
  </div>

  <div class="px-4 pb-4">
    <Composer placeholder="Reply…" variant="reply" channel="general" />
  </div>
</MockFrame>

<script>
  import "../scripts/chat-anim.ts";
</script>
