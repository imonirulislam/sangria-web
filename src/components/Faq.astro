---
import Icon from "./Icon.astro";
import { FAQ } from "../data/content";
---

<div class="mx-auto max-w-3xl divide-y divide-neutral-200 dark:divide-white/10">
  {
    FAQ.map((item) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold [&::-webkit-details-marker]:hidden">
          {item.q}
          <Icon
            name="chevron-down"
            class="size-5 shrink-0 text-neutral-400 transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <p class="mt-3 max-w-2xl text-neutral-600 dark:text-neutral-400">{item.a}</p>
      </details>
    ))
  }
</div>
