---
import * as simpleIcons from "simple-icons";
import Icon from "./Icon.astro";
import type { Platform } from "../data/content";

type Props = Platform;
const { os, name, kind, href, available, note } = Astro.props;

// Real OS brand marks where available; Windows was pulled from simple-icons for
// trademark reasons, so it falls back to a generic desktop glyph.
const SLUG: Record<Props["os"], string | null> = {
  mac: "siApple",
  windows: null,
  linux: "siLinux",
  ios: "siApple",
  android: "siAndroid",
};
const icons = simpleIcons as Record<string, { path: string } | undefined>;
const slug = SLUG[os];
const path = slug ? (icons[slug]?.path ?? null) : null;
---

<div
  data-os-card={os}
  class="relative flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-6 transition-colors hover:border-neutral-300 dark:border-white/10 dark:bg-neutral-900 dark:hover:border-white/20"
>
  {/* revealed by os-detect.ts when this is the visitor's platform */}
  <span
    data-detected-badge
    class="absolute -top-2.5 right-4 hidden rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-white shadow-sm"
  >
    Your platform
  </span>

  <div
    class="mb-4 flex size-12 items-center justify-center rounded-xl bg-neutral-100 text-neutral-800 dark:bg-white/5 dark:text-white"
  >
    {
      path ? (
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
          <path d={path} />
        </svg>
      ) : (
        <Icon name="monitor" class="size-6" />
      )
    }
  </div>

  <h3 class="text-lg font-semibold">{name}</h3>
  <p class="mt-1 text-sm text-neutral-500">{kind}</p>
  <p class="mt-3 flex-1 text-sm text-neutral-600 dark:text-neutral-400">{note}</p>

  {
    available ? (
      <a
        href={href}
        class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        <Icon name="download" class="size-4" />
        Download
      </a>
    ) : (
      <span class="mt-5 inline-flex items-center justify-center rounded-lg border border-neutral-200 px-4 py-2.5 text-sm font-medium text-neutral-400 dark:border-white/10">
        Coming soon
      </span>
    )
  }
</div>
