---
// A window-framed screenshot. When `src` is set it renders the image; until then
// it shows a labeled placeholder — drop a real capture into public/screenshots/
// and pass its path (e.g. src="/screenshots/general.png").
interface Props {
  src?: string;
  alt: string;
  label?: string;
}
const { src, alt, label } = Astro.props;
---

<figure
  class="overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-xl ring-1 ring-black/5 dark:border-neutral-800 dark:bg-neutral-900"
>
  <div
    class="flex items-center gap-1.5 border-b border-neutral-200 bg-neutral-50 px-4 py-3 dark:border-neutral-800 dark:bg-neutral-900/60"
  >
    <span class="size-3 rounded-full bg-red-400/70"></span>
    <span class="size-3 rounded-full bg-amber-400/70"></span>
    <span class="size-3 rounded-full bg-green-400/70"></span>
  </div>
  {
    src ? (
      <img src={src} alt={alt} class="block w-full" loading="lazy" />
    ) : (
      <div class="flex aspect-video w-full items-center justify-center bg-gradient-to-br from-brand-50 to-brand-100 dark:from-neutral-800 dark:to-neutral-900">
        <span class="px-6 text-center text-sm font-medium text-brand-700/70 dark:text-neutral-500">
          {label ?? alt}
        </span>
      </div>
    )
  }
</figure>
