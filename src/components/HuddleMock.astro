---
// Mirrors the app's huddle: a header, dark #1A1D21 tiles with white/10 borders, a
// shared screen, and a controls bar (mic / camera / screen active / leave). The
// emerald "speaking" ring cycles between participants via CSS (staggered delays).
import Icon from "./Icon.astro";
import MockFrame from "./MockFrame.astro";

const people = [
  { initials: "PN", grad: "from-emerald-400 to-teal-600", name: "Priya", delay: "0s" },
  { initials: "DS", grad: "from-sky-400 to-indigo-600", name: "Diego", delay: "3.75s" },
];
---

<MockFrame bodyClass="bg-[#16181c]">
  {/* header */}
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-3 text-sm">
    <span class="flex items-center gap-2 font-medium text-white/90">
      <span
        class="flex size-6 items-center justify-center rounded-md bg-gradient-to-br from-emerald-500 to-emerald-700"
      >
        <Icon name="headphones" class="size-3.5 text-white" />
      </span>
      Huddle in <span class="text-white/60">#general</span>
    </span>
    <span class="text-xs text-white/40">3 people</span>
  </div>

  <div class="p-4">
    <div class="grid grid-cols-3 gap-3">
      {/* shared screen with faux content */}
      <div
        class="relative col-span-2 aspect-video overflow-hidden rounded-lg border border-white/10 bg-[#0f1113]"
      >
        <div class="flex h-full flex-col gap-2 p-4">
          <div class="h-2.5 w-1/3 rounded bg-white/15"></div>
          <div class="h-2 w-3/5 rounded bg-white/10"></div>
          <div class="mt-1 grid flex-1 grid-cols-3 gap-2">
            <div class="rounded bg-white/[0.06]"></div>
            <div class="rounded bg-white/[0.06]"></div>
            <div class="rounded bg-white/[0.06]"></div>
          </div>
        </div>
        <span
          class="absolute bottom-2 left-2 flex items-center gap-1.5 rounded bg-black/60 px-2 py-1 text-xs text-white"
        >
          <Icon name="monitor" class="size-3.5" /> Ava — Sharing
        </span>
      </div>

      {/* participant tiles */}
      <div class="grid grid-rows-2 gap-3">
        {
          people.map((p) => (
            <div
              class="speaker relative flex items-center justify-center overflow-hidden rounded-lg border border-white/10 bg-[#1A1D21]"
              style={`animation-delay:${p.delay}`}
            >
              <div
                class:list={[
                  "flex size-12 items-center justify-center rounded-md bg-gradient-to-br text-sm font-semibold text-white",
                  p.grad,
                ]}
              >
                {p.initials}
              </div>
              <span class="absolute bottom-1.5 left-1.5 flex items-center gap-1 rounded bg-black/60 px-1.5 py-0.5 text-[10px] text-white">
                <Icon name="mic" class="size-2.5" /> {p.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    {/* controls */}
    <div
      class="mt-3 flex flex-wrap items-center justify-between gap-y-2 rounded-xl border border-white/10 bg-black/40 px-4 py-2.5 backdrop-blur"
    >
      <span class="text-sm font-medium text-white/70">00:42</span>
      <div class="flex items-center gap-2">
        <span class="flex size-9 items-center justify-center rounded-full bg-white/10 text-white">
          <Icon name="mic" class="size-4" />
        </span>
        <span class="flex size-9 items-center justify-center rounded-full bg-white/10 text-white">
          <Icon name="video" class="size-4" />
        </span>
        <span class="flex size-9 items-center justify-center rounded-full bg-emerald-500 text-white">
          <Icon name="monitor" class="size-4" />
        </span>
        <span class="flex size-9 items-center justify-center rounded-full bg-red-500 text-white">
          <Icon name="phone" class="size-4" />
        </span>
      </div>
    </div>
  </div>
</MockFrame>
