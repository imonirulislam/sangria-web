---
import { SITE } from "../data/content";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300 data-[scrolled]:border-neutral-200/70 data-[scrolled]:bg-white/75 data-[scrolled]:shadow-sm data-[scrolled]:backdrop-blur-lg dark:data-[scrolled]:border-white/10 dark:data-[scrolled]:bg-neutral-950/75"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="/" class="group/logo flex items-center gap-2.5 font-semibold">
      <img
        src="/icon.svg"
        alt=""
        aria-hidden="true"
        class="size-8 rounded-lg shadow-sm ring-1 ring-black/5 transition-transform duration-200 group-hover/logo:scale-105 dark:ring-white/10"
      />
      <span class="text-lg tracking-tight">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-2">
      {/* Secondary button */}
      <a
        href="/features"
        class:list={[
          "hidden items-center rounded-lg border px-3.5 py-2 text-sm font-medium transition-colors sm:inline-flex",
          isActive("/features")
            ? "border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-400/30 dark:bg-brand-500/10 dark:text-brand-300"
            : "border-neutral-200/80 bg-white/60 text-neutral-700 hover:border-neutral-300 hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-neutral-200 dark:hover:bg-white/10",
        ]}
      >
        Features
      </a>

      {/* Primary CTA */}
      <a
        href="/download"
        class:list={[
          "inline-flex items-center rounded-lg bg-gradient-to-b from-brand-600 to-brand-700 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-brand-700/25 ring-1 ring-inset ring-white/15 transition-all duration-200 hover:-translate-y-px hover:from-brand-500 hover:shadow-md hover:shadow-brand-700/30 active:translate-y-0 active:shadow-sm",
          isActive("/download") && "ring-white/30",
        ]}
      >
        Download
      </a>

      <span class="mx-0.5 hidden h-6 w-px bg-neutral-200 sm:block dark:bg-white/10"></span>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  // The bar is transparent over the hero and gains a blurred, shadowed backdrop
  // once you scroll — a small premium touch.
  const nav = document.getElementById("site-nav");
  const sync = () => nav?.toggleAttribute("data-scrolled", window.scrollY > 8);
  sync();
  window.addEventListener("scroll", sync, { passive: true });
</script>
