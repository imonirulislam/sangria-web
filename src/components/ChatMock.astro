---
// A stylized, static mock of the Sangria chat UI — the hero product shot,
// rendered in HTML/CSS so it stays crisp at any size (no screenshot needed).
import Icon from "./Icon.astro";
import Composer from "./Composer.astro";

const navItems = [
  { icon: "thread", label: "Threads" },
  { icon: "headphones", label: "Huddles" },
  { icon: "bookmark", label: "Later" },
];

const channels = [
  { name: "general", active: true },
  { name: "announcements", active: false },
  { name: "engineering", active: false },
];

const dms = [
  { initials: "PN", grad: "from-emerald-400 to-teal-600", name: "Priya Nair", online: true },
  { initials: "DS", grad: "from-sky-400 to-indigo-600", name: "Diego Santos", online: false },
];

const tabs = [
  { icon: "message-square", label: "Messages", active: true },
  { icon: "paperclip", label: "Files & links", active: false },
  { icon: "pin", label: "Pins", active: false },
];

const messages = [
  {
    initials: "AC",
    grad: "from-brand-500 to-brand-700",
    name: "Ava Chen",
    time: "9:12 AM",
    text: "Morning! The Q3 planning doc is open for comments through Friday 📄",
    reactions: [{ e: "👍", n: 5 }],
    thread: null as null | string,
  },
  {
    initials: "MW",
    grad: "from-citrus-400 to-brand-500",
    name: "Marcus Webb",
    time: "9:36 AM",
    text: "Shipped the new onboarding flow to staging — would love eyes before we roll it out 👀",
    reactions: [
      { e: "🚀", n: 7 },
      { e: "🔥", n: 2 },
    ],
    thread: "3 replies",
  },
];
---

<div
  class="overflow-hidden rounded-2xl border border-neutral-200/80 bg-white shadow-[0_28px_70px_-28px_rgba(24,24,27,0.28)] dark:border-white/10 dark:bg-neutral-900 dark:shadow-[0_28px_70px_-28px_rgba(0,0,0,0.75)]"
>
  <div class="flex h-[460px] text-left">
    {/* sidebar */}
    <aside
      class="hidden w-60 shrink-0 flex-col overflow-hidden bg-gradient-to-b from-brand-800 to-brand-900 text-brand-100 sm:flex"
    >
      <div class="flex items-center gap-2 px-3 py-3 font-semibold text-white">
        <img src="/icon.svg" alt="" class="size-6 rounded-md" />
        Acme Inc
      </div>

      <div class="px-3 pb-3">
        <div
          class="flex items-center gap-2 rounded-md bg-white/10 px-2.5 py-1.5 text-xs text-brand-100/70"
        >
          <Icon name="search" class="size-3.5" />
          Find conversations
        </div>
      </div>

      <div class="flex-1 space-y-3 overflow-hidden px-2">
        <ul class="space-y-0.5">
          {
            navItems.map((n) => (
              <li class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-brand-100/80">
                <Icon name={n.icon} class="size-4 opacity-70" />
                {n.label}
              </li>
            ))
          }
        </ul>

        <div>
          <p class="px-2 pb-1 text-xs font-medium uppercase tracking-wide text-brand-300/70">
            Channels
          </p>
          <ul class="space-y-0.5">
            {
              channels.map((c) => (
                <li
                  class:list={[
                    "flex items-center gap-1.5 rounded-md px-2 py-1.5 text-sm",
                    c.active ? "bg-white/15 font-medium text-white" : "text-brand-100/80",
                  ]}
                >
                  <span class="opacity-60">#</span>
                  {c.name}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="px-2 pb-1 text-xs font-medium uppercase tracking-wide text-brand-300/70">
            Direct messages
          </p>
          <ul class="space-y-0.5">
            {
              dms.map((d) => (
                <li class="flex items-center gap-2 rounded-md px-2 py-1 text-sm text-brand-100/80">
                  <span class="relative">
                    <span
                      class:list={[
                        "flex size-5 items-center justify-center rounded-md bg-gradient-to-br text-[9px] font-semibold text-white",
                        d.grad,
                      ]}
                    >
                      {d.initials}
                    </span>
                    <span
                      class:list={[
                        "absolute -bottom-0.5 -right-0.5 size-2 rounded-full ring-2 ring-brand-900",
                        d.online ? "bg-emerald-400" : "bg-neutral-500",
                      ]}
                    />
                  </span>
                  {d.name}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="px-2 pb-1 text-xs font-medium uppercase tracking-wide text-brand-300/70">Apps</p>
          <ul>
            <li class="flex items-center gap-2 rounded-md px-2 py-1 text-sm text-brand-100/80">
              <img src="/icon.svg" alt="" class="size-5 rounded-md" />
              Sangriabot
              <span class="rounded bg-white/15 px-1 text-[9px] font-semibold uppercase">App</span>
            </li>
          </ul>
        </div>
      </div>
    </aside>

    {/* main */}
    <div class="flex min-w-0 flex-1 flex-col bg-white dark:bg-neutral-900">
      {/* channel header */}
      <div class="flex items-center justify-between border-b border-neutral-200 px-5 py-3 dark:border-white/10">
        <span class="flex items-center gap-1.5 font-semibold">
          <span class="text-neutral-400">#</span> general
        </span>
        <span class="flex items-center gap-3 text-neutral-400">
          <Icon name="headphones" class="size-4" />
          <span class="flex items-center gap-1 text-sm">
            <Icon name="users" class="size-4" /> 252
          </span>
        </span>
      </div>

      {/* tabs */}
      <div class="flex items-center gap-1 border-b border-neutral-200 px-3 dark:border-white/10">
        {
          tabs.map((t) => (
            <span
              class:list={[
                "flex items-center gap-1.5 border-b-2 px-2.5 py-2.5 text-sm font-medium",
                t.active
                  ? "border-neutral-900 text-neutral-900 dark:border-white dark:text-white"
                  : "border-transparent text-neutral-400",
              ]}
            >
              <Icon name={t.icon} class="size-4" />
              {t.label}
            </span>
          ))
        }
      </div>

      {/* messages */}
      <div data-chat class="flex-1 space-y-5 overflow-hidden px-5 py-5">
        {
          messages.map((m, i) => (
            <div data-msg class="msg-pre flex gap-3">
              <div
                class:list={[
                  "flex size-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br text-sm font-semibold text-white",
                  m.grad,
                ]}
              >
                {m.initials}
              </div>
              <div class="min-w-0">
                <div class="flex items-baseline gap-2">
                  <span class="font-semibold">{m.name}</span>
                  <span class="text-xs text-neutral-400">{m.time}</span>
                </div>
                <p class="mt-0.5 text-sm text-neutral-700 dark:text-neutral-300">{m.text}</p>
                {m.reactions.length > 0 && (
                  <div class="mt-2 flex gap-1.5">
                    {m.reactions.map((r) => (
                      <span
                        data-react
                        data-target={r.n}
                        data-at={i}
                        class="react-pre inline-flex items-center gap-1 rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:border-brand-400/30 dark:bg-brand-400/10 dark:text-brand-200"
                      >
                        {r.e} <span data-count>{r.n}</span>
                      </span>
                    ))}
                  </div>
                )}
                {m.thread && (
                  <button class="mt-2 flex items-center gap-1.5 text-xs font-semibold text-brand-600 dark:text-brand-300">
                    <span class="flex -space-x-1.5">
                      <span class="size-4 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 ring-2 ring-white dark:ring-neutral-900" />
                      <span class="size-4 rounded-full bg-gradient-to-br from-citrus-400 to-brand-500 ring-2 ring-white dark:ring-neutral-900" />
                    </span>
                    {m.thread}
                  </button>
                )}
              </div>
            </div>
          ))
        }
      </div>

      {/* composer */}
      <div class="px-5 pb-5">
        <Composer placeholder="Message #general" />
      </div>
    </div>
  </div>
</div>

<script>
  import "../scripts/chat-anim.ts";
</script>
